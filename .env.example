# Databricks Analytics Connection
# Create a .env file and populate these with your SQL Warehouse credentials

# The frontend uses this to know where to fetch data
VITE_DATABRICKS_ANALYTICS_URL=/api/analytics

# Secure backend credentials (do NOT prefix with VITE_)
DATABRICKS_SERVER_HOSTNAME=your_databricks_hostname
DATABRICKS_HTTP_PATH=your_http_path
DATABRICKS_TOKEN=your_pat_token
SARVAM_API_KEY=your_sarvam_api_key
